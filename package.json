{
  "name": "starforge",
  "version": "0.0.0",
  "private": true,
  "description": "Turn GitHub activity into deterministic 3D particle visuals for your profile README",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write ."
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
