{
  "name": "starforge",
  "version": "0.0.0",
  "private": true,
  "description": "Turn GitHub activity into deterministic 3D particle visuals for your profile README",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write ."
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
